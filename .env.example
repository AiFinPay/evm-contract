# AiFinPay EVM Contracts — environment template
#
# Copy this file to .env and fill in the values, or use Hardhat Keystore
# for production deployer keys and the Etherscan API key.
#
# Priority in hardhat.config.ts for mainnet deployer keys:
#
#   1. Ledger hardware wallet (set LEDGER_ACCOUNT)
#   2. Hardhat Keystore variables (bunx hardhat keystore set <KEY>)
#   3. Environment variables (this file), e.g. PROD_DEPLOYER_KEY or *_DEPLOYER_KEY
#
# Best practice: do not put production private keys in .env. Use Ledger, or
# store them encrypted with `bunx hardhat keystore set <KEY>`.

# ---------------------------------------------------------------------------
# TESTNET (Polygon Amoy only)
# ---------------------------------------------------------------------------

# Private key for testnet deploys. Used only on the `amoy` network.
# DEV_DEPLOYER_KEY=0x...

# Custom Polygon Amoy RPC (optional, default is the public endpoint)
# AMOY_RPC=https://rpc-amoy.polygon.technology

# Amoy Safe address for B2BSplitterV13 governance (used by deploy-splitter-v13.ts)
# AMOY_TEST_SAFE=0x...

# Freely-mintable mock stablecoin for the Amoy USDT slot (optional)
# AMOY_TEST_STABLE=0x...

# ---------------------------------------------------------------------------
# MAINNET DEPLOYER KEYS (optional — prefer Hardhat Keystore or Ledger)
# ---------------------------------------------------------------------------
#
# PROD_DEPLOYER_KEY is used as a single deployer across all mainnet networks.
# If unset, each network falls back to LEDGER_ACCOUNT (if set) and then to
# PROD_DEPLOYER_KEY / <NETWORK>_DEPLOYER_KEY in Hardhat Keystore, and only as a
# last resort to environment variables.
#
# PROD_DEPLOYER_KEY=0x...
# POLYGON_DEPLOYER_KEY=0x...
# AVALANCHE_DEPLOYER_KEY=0x...
# ARBITRUM_DEPLOYER_KEY=0x...
# BNB_DEPLOYER_KEY=0x...
# BASE_DEPLOYER_KEY=0x...
# UNICHAIN_DEPLOYER_KEY=0x...
# OPTIMISM_DEPLOYER_KEY=0x...
# BOTCHAIN_DEPLOYER_KEY=0x...
# XRPLEVM_DEPLOYER_KEY=0x...
# ROBINHOOD_DEPLOYER_KEY=0x...

# ---------------------------------------------------------------------------
# RPC ENDPOINTS (all optional, defaults are configured in hardhat.config.ts)
# ---------------------------------------------------------------------------

# POLYGON_MAINNET_RPC=https://polygon-bor-rpc.publicnode.com
# AVALANCHE_MAINNET_RPC=https://api.avax.network/ext/bc/C/rpc
# ARBITRUM_MAINNET_RPC=https://arb1.arbitrum.io/rpc
# BNB_MAINNET_RPC=https://bsc-dataseed.binance.org
# BASE_MAINNET_RPC=https://mainnet.base.org
# UNICHAIN_RPC=https://mainnet.unichain.org
# OPTIMISM_RPC=https://mainnet.optimism.io
# BOTCHAIN_RPC=https://rpc.botchain.ai
# XRPLEVM_RPC=https://rpc.xrplevm.org
# ROBINHOOD_RPC=https://robinhood-rpc.publicnode.com

# ---------------------------------------------------------------------------
# VERIFICATION
# ---------------------------------------------------------------------------

# Unified Etherscan v2 API key. Also accepts the legacy POLYGONSCAN_API_KEY.
# ETHERSCAN_API_KEY=...
# POLYGONSCAN_API_KEY=...

# ---------------------------------------------------------------------------
# HARDWARE WALLET (highest priority for all mainnet networks)
# ---------------------------------------------------------------------------

# Ledger account used when no deployer key is configured.
# LEDGER_ACCOUNT=0x...

# ---------------------------------------------------------------------------
# AIFINPAY ACCOUNTS
# ---------------------------------------------------------------------------

