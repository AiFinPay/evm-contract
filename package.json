{
  "name": "@aifinpay/evm-contract",
  "version": "1.0.0",
  "description": "AiFinPay EVM-compatible Smart Contracts",
  "main": "index.js",
  "packageManager": "bun",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "hardhat test mocha",
    "build": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.ts --network polygon --build-profile production",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network amoy --build-profile production",
    "deploy:splitter": "hardhat run scripts/deploy-splitter-v12.ts --network polygon --build-profile production",
    "lint": "solhint 'contracts/**/*.sol'",
    "prettify": "prettier --write 'contracts/**/*.sol'",
    "prettify:check": "prettier --check 'contracts/**/*.sol'"
  },
  "keywords": [
    "aifinpay",
    "polygon",
    "solidity",
    "erc20",
    "erc721"
  ],
  "contributors": [
    {
      "name": "Pavlo Bolhar",
      "email": "pavlo.bolhar@proton.me"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@daochild/agents-config": "^1.0.7",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.14.0",
    "chai": "^5.3.3",
    "dotenv": "^17.4.2",
    "ethers": "^6.14.0",
    "hardhat": "^3.12.0",
    "mocha": "^11.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-solidity": "^2.4.0",
    "solhint": "^6.2.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "elliptic": "^6.6.1"
  }
}
