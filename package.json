{
  "name": "@aifinpay/evm-contract",
  "version": "1.0.0",
  "description": "AiFinPay EVM-compatible Smart Contracts",
  "main": "index.js",
  "packageManager": "bun",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "hardhat test",
    "build": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.ts --network polygon",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network amoy",
    "lint": "solhint 'contracts/**/*.sol'",
    "prettify": "prettier --write 'contracts/**/*.sol'",
    "prettify:check": "prettier --check 'contracts/**/*.sol'"
  },
  "keywords": [
    "aifinpay",
    "polygon",
    "solidity",
    "erc20",
    "erc721"
  ],
  "contributors": [
    {
      "name": "Pavlo Bolhar",
      "email": "pavlo.bolhar@proton.me",
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^17.4.2",
    "hardhat": "^2.29.0",
    "prettier": "^3.9.6",
    "prettier-plugin-solidity": "^2.4.0",
    "solhint": "^6.2.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "axios": "^1.8.4",
    "brace-expansion": "^5.0.9",
    "cookie": "^0.7.2",
    "diff": "^8.0.3",
    "elliptic": "^6.6.1",
    "fast-uri": "^3.0.6",
    "form-data": "^4.0.2",
    "immutable": "^5.1.1",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21",
    "qs": "^6.14.0",
    "serialize-javascript": "^7.0.5",
    "tmp": "^0.2.3",
    "undici": "^7.8.0",
    "uuid": "^11.1.1",
    "ws": "^8.18.2"
  }
}
