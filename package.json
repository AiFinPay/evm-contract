{
  "name": "@aifinpay/evm-contract",
  "version": "1.0.0",
  "description": "AiFinPay EVM-compatible Smart Contracts",
  "main": "index.js",
  "packageManager": "bun",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "hardhat test",
    "build": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.ts --network polygon",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network amoy",
    "lint": "solhint 'contracts/**/*.sol'",
    "prettify": "prettier --write 'contracts/**/*.sol'",
    "prettify:check": "prettier --check 'contracts/**/*.sol'"
  },
  "keywords": [
    "aifinpay",
    "polygon",
    "solidity",
    "erc20",
    "erc721"
  ],
  "contributors": [
    {
      "name": "Pavlo Bolhar",
      "email": "pavlo.bolhar@proton.me"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@daochild/agents-config": "^1.0.7",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "dotenv": "^17.4.2",
    "hardhat": "^3.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-solidity": "^2.4.0",
    "solhint": "^6.2.3",
    "typescript": "^7.0.2"
  }
}
