{
  "name": "@aifinpay/evm-contract",
  "version": "1.3.0",
  "description": "AiFinPay EVM-compatible Smart Contracts",
  "main": "index.js",
  "packageManager": "bun",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "hardhat test mocha",
    "build": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.ts --network polygon --build-profile production",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network amoy --build-profile production",
    "deploy:splitter": "hardhat run scripts/deploy-splitter-v12.ts --network polygon --build-profile production",
    "deploy:v14": "hardhat run scripts/deploy-splitter-v14-production.ts --build-profile production",
    "deploy:v14:testnet": "hardhat run scripts/deploy-splitter-v14.ts --network amoy --build-profile production",
    "deploy:timelock": "hardhat run scripts/deploy-timelock.ts --network polygon",
    "verify": "hardhat run scripts/verify.ts --network polygon --build-profile production",
    "lint": "solhint 'contracts/**/*.sol'",
    "prettify": "bun scripts/prettier-write.ts",
    "prettify:check": "bun scripts/prettier-check.ts"
  },
  "keywords": [
    "aifinpay",
    "polygon",
    "solidity",
    "erc20",
    "erc721"
  ],
  "contributors": [
    {
      "name": "Pavlo Bolhar",
      "email": "pavlo.bolhar@proton.me"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@daochild/agents-config": "^1.2.1",
    "@nomicfoundation/hardhat-keystore": "^3.0.13",
    "@nomicfoundation/hardhat-ledger": "^3.0.10",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/bun": "^1.3.14",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^5.3.3",
    "dotenv": "^17.4.2",
    "ethers": "^6.14.0",
    "forge-std": "^1.1.2",
    "glob": "^13.0.6",
    "hardhat": "^3.12.0",
    "mocha": "^11.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-solidity": "^2.4.0",
    "solhint": "^6.2.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "diff": "^8.0.3",
    "elliptic": "^6.6.1",
    "serialize-javascript": "^7.0.5",
    "axios": "^1.15.2"
  }
}
