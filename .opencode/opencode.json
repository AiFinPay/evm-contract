{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "sol": {
      "command": ["forge", "fmt", "--"],
      "extensions": [".sol"]
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      ".env*": "deny",
      "**/.env*": "deny",
      "*.log": "deny",
      "**/*.log": "deny",
      "logs/**": "deny",
      "**/logs/**": "deny",
      "secrets/**": "deny",
      "**/secrets/**": "deny",
      "*.key": "deny",
      "**/*.key": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.p12": "deny",
      "**/*.p12": "deny",
      "*.pfx": "deny",
      "**/*.pfx": "deny"
    },
    "edit": {
      "*": "allow",
      ".env*": "deny",
      "**/.env*": "deny",
      "*.log": "deny",
      "**/*.log": "deny",
      "logs/**": "deny",
      "**/logs/**": "deny",
      "secrets/**": "deny",
      "**/secrets/**": "deny",
      "*.key": "deny",
      "**/*.key": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.p12": "deny",
      "**/*.p12": "deny",
      "*.pfx": "deny",
      "**/*.pfx": "deny"
    },
    "glob": {
      "*": "allow",
      ".env*": "deny",
      "**/.env*": "deny",
      "*.log": "deny",
      "**/*.log": "deny",
      "logs/**": "deny",
      "**/logs/**": "deny",
      "secrets/**": "deny",
      "**/secrets/**": "deny",
      "*.key": "deny",
      "**/*.key": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.p12": "deny",
      "**/*.p12": "deny",
      "*.pfx": "deny",
      "**/*.pfx": "deny"
    },
    "grep": {
      "*": "allow",
      ".env*": "deny",
      "**/.env*": "deny",
      "*.log": "deny",
      "**/*.log": "deny",
      "logs/**": "deny",
      "**/logs/**": "deny",
      "secrets/**": "deny",
      "**/secrets/**": "deny",
      "*.key": "deny",
      "**/*.key": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.p12": "deny",
      "**/*.p12": "deny",
      "*.pfx": "deny",
      "**/*.pfx": "deny"
    },
    "list": {
      "*": "allow",
      "logs": "deny",
      "logs/**": "deny",
      "**/logs/**": "deny",
      "secrets": "deny",
      "secrets/**": "deny",
      "**/secrets/**": "deny"
    },
    "external_directory": {
      "*": "allow",
      "**/.env*": "deny",
      "**/*.log": "deny",
      "**/logs/**": "deny",
      "**/secrets/**": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny"
    },
    "bash": {
      "*": "allow",
      "cat .env*": "deny",
      "cat **/.env*": "deny",
      "cat *.log": "deny",
      "cat **/*.log": "deny",
      "env*": "deny",
      "printenv*": "deny"
